{
  "name": "deepsearch-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.2",
    "@choc-ui/chakra-autocomplete": "^5.8.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@omniverse/auth": "file:_packages/omniverse.auth.client.js",
    "@omniverse/discovery": "file:_packages/omniverse.discovery.client.js",
    "@omniverse/idl": "file:_packages/idl.js/src",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "cookie": "^0.5.0",
    "d3": "^7.9.0",
    "framer-motion": "^11.1.7",
    "jwt-decode": "^3.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "e2e:auth": "npx tsx e2e/auth-setup.ts",
    "e2e": "npx playwright test --config=playwright.config.ts --project=live-chromium",
    "e2e:smoke": "npx playwright test --config=playwright.config.ts --project=live-chromium smoke.spec.ts",
    "e2e:mock": "npx playwright test --config=playwright.config.ts --project=mock-chromium",
    "e2e:visual": "npx playwright test --config=playwright.config.ts --project=visual",
    "e2e:visual:update": "npx playwright test --config=playwright.config.ts --project=visual --update-snapshots",
    "e2e:report": "npx playwright show-report",
    "e2e:ui": "npx playwright test --config=playwright.config.ts --ui",
    "e2e:debug": "npx playwright test --config=playwright.config.ts --project=live-chromium --headed --debug",
    "e2e:install": "npx playwright install chromium"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0"
  }
}
